#!/bin/bash

# --- oci_bastion_helper.sh ---

echo "Checking for existing active sessions..."

# Retrieve all ACTIVE sessions
ACTIVE_SESSIONS=$(oci bastion session list \
    --bastion-id "$BASTION_ID" \
    --session-lifecycle-state ACTIVE \
    --all 2>/dev/null | jq -r --arg tid "$TARGET_ID" '.data[]? | select(."target-resource-details"."target-resource-id" == $tid) | .id')

if [ -n "$ACTIVE_SESSIONS" ]; then
    echo "Found existing active session(s). Cleaning up..."
    for SID in $ACTIVE_SESSIONS; do
        oci bastion session delete --session-id "$SID" --force 2>/dev/null
    done
    sleep 4
else
    echo "No existing active sessions found."
fi

echo "Initiating NEW OCI Bastion Session..."

SESSION_JSON=$(oci bastion session create-port-forwarding \
    --bastion-id "$BASTION_ID" \
    --target-resource-id "$TARGET_ID" \
    --target-port 22 \
    --ssh-public-key-file "${BASTION_KEY}.pub" \
    --session-ttl 10800 2>/dev/null)

SESSION_ID=$(echo "$SESSION_JSON" | jq -r '.data.id')

if [ -z "$SESSION_ID" ] || [ "$SESSION_ID" == "null" ]; then
    echo "Error: Failed to trigger bastion session creation."
    return 1 2>/dev/null || exit 1
fi

echo "Waiting for session to become ACTIVE..."

while true; do
    STATE=$(oci bastion session get --session-id "$SESSION_ID" | jq -r '.data."lifecycle-state"')
    if [ "$STATE" == "ACTIVE" ]; then
        echo "State is ACTIVE. Proceeding to connection phase..."
        break
    elif [ "$STATE" == "FAILED" ] || [ "$STATE" == "DELETED" ]; then
        echo "Error: Session failed to provision or was deleted."
        return 1 2>/dev/null || exit 1
    fi
    sleep 3
done

SSH_METADATA=$(oci bastion session get --session-id "$SESSION_ID" | jq -r '.data."ssh-metadata".command')
BASTION_TARGET=$(echo "$SSH_METADATA" | grep -oE 'ocid1\.bastionsession\.[a-zA-Z0-9._-]+@[a-zA-Z0-9._-]+')

RETRY_COUNT=0
while [ $RETRY_COUNT -lt $MAX_RETRIES ]; do
    echo "Attempting SSH connection (Attempt $((RETRY_COUNT + 1)) of $MAX_RETRIES)..."

    ssh -i "$INSTANCE_KEY" \
        -o StrictHostKeyChecking=no \
        -o UserKnownHostsFile=/dev/null \
        -o ProxyCommand="ssh -i $BASTION_KEY -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null -W %h:%p -p 22 $BASTION_TARGET" \
        "${TARGET_USER}@${TARGET_IP}"

    SSH_EXIT_CODE=$?
    if [ $SSH_EXIT_CODE -ne 255 ]; then
        return $SSH_EXIT_CODE 2>/dev/null || exit $SSH_EXIT_CODE
    fi

    echo "Connection failed (Race condition/Key not loaded yet)."
    RETRY_COUNT=$((RETRY_COUNT + 1))

    if [ $RETRY_COUNT -lt $MAX_RETRIES ]; then
        echo "Retrying in $BACKOFF seconds..."
        sleep $BACKOFF
        BACKOFF=$((BACKOFF * 2))
    fi
done

echo "All $MAX_RETRIES attempts exhausted."
